aws_region  = "us-east-1"
project     = "myapp"
environment = "dev"

vpc_cidr = "10.0.0.0/16"
az_count = 2

enable_nat_gateway = true
single_nat_gateway = true # set false in prod for one NAT per AZ
enable_flow_logs   = true

db_port = 5432 # 3306 for MySQL

tags = {
  Owner      = "platform-team"
  CostCenter = "engineering"
}
